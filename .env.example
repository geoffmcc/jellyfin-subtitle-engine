# Copy to .env, populate locally, and run chmod 600 .env
JELLYFIN_URL=http://your-jellyfin-server:8096
JELLYFIN_TOKEN=replace-with-your-api-token
JELLYFIN_USER_ID=replace-with-your-user-id

# Optional: prefer a named Jellyfin session if JELLYFIN_USER_ID is not set:
# JELLYFIN_TV=Your TV Name

# Required for speaker analysis and safe subtitle installation:
MEDIA_SERVER_ROOT=/path/as/seen/by/jellyfin
MEDIA_MOUNT_ROOT=/path/to/local/media/mount

# Speaker diarization requires an HF_TOKEN environment variable.
